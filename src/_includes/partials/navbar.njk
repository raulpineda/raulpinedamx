<nav class="sticky top-0 z-40 flex items-center justify-between bg-white/90 px-8 py-4 backdrop-blur-sm dark:bg-surface/95 lg:px-16" id="nav">
  <a href="/" class="text-sm font-bold text-highlight dark:text-highlight-light">~/<span id="nav-section"></span></a>
  <div class="hidden items-center gap-8 text-sm text-slate-500 dark:text-slate-400 md:flex">
    {% for link in site.navLinks %}
    <a href="{{ link.href }}" class="transition hover:text-slate-900 dark:hover:text-slate-100">{{ link.name }}</a>
    {% endfor %}
    <button id="theme-toggle" class="rounded-md p-1 text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100" aria-label="Toggle dark mode">
      <svg id="theme-icon-sun" class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
      </svg>
      <svg id="theme-icon-moon" class="block h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
      </svg>
    </button>
  </div>
  <button id="theme-toggle-mobile" class="rounded-md p-1 text-slate-500 transition hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-100 md:hidden" aria-label="Toggle dark mode">
    <svg class="hidden h-4 w-4 dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
    </svg>
    <svg class="block h-4 w-4 dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
    </svg>
  </button>
</nav>
